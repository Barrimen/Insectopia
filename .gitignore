*.zip
*.7z
*.rar
*.bak
*.backup
*.tmp
*~

# ============================================================
# Foundry VTT : bases LevelDB générées
#
# À conserver uniquement si packs-src/ est la source officielle
# et que les compendiums peuvent être reconstruits.
# ============================================================
packs/**/*.ldb
packs/**/*.log
packs/**/CURRENT
packs/**/LOCK
packs/**/LOG
packs/**/LOG.old
packs/**/MANIFEST-*

# Fichiers de verrouillage ou temporaires Foundry
*.lock

# ============================================================
# Journaux génériques
# ============================================================
*.log
logs/
