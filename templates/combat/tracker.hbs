<ol class="combat-tracker plain">
    {{#each turns}}
    <li class="combatant {{ css }}" data-combatant-id="{{ id }}" data-action="activateCombatant">
        <img class="token-image" src="{{ img }}" alt="{{ name }}" loading="lazy">

        <div class="token-name">
            <strong class="name">{{ name }}</strong>
            <div class="combatant-controls">
                {{#if @root.user.isGM}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
                        data-action="toggleHidden" data-tooltip aria-label="{{ localize "COMBAT.ToggleVis" }}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
                        data-action="toggleDefeated" data-tooltip aria-label="{{ localize "COMBAT.ToggleDead" }}"></button>
                {{/if}}
                {{#if canPing}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
                        data-action="pingCombatant" data-tooltip aria-label="{{ localize "COMBAT.PingCombatant" }}"></button>
                {{/if}}
                <div class="token-effects" data-tooltip-html="{{ effects.tooltip }}">
                    {{#each effects.icons}}
                    <img class="token-effect" src="{{ img }}" alt="{{ name }}">
                    {{/each}}
                </div>
            </div>
        </div>

        {{#if resource includeZero=true}}
        <div class="token-resource"><span class="resource">{{ resource }}</span></div>
        {{/if}}

        <div class="token-initiative blattes-initiative">
            {{#if initiative}}
                {{#times initblattes.rouge}}<span class="blatte blatte-small blatte-rouge"></span>{{/times}}
                {{#times initblattes.verte}}<span class="blatte blatte-small blatte-verte"></span>{{/times}}
                {{#times initblattes.bleue}}<span class="blatte blatte-small blatte-bleue"></span>{{/times}}
                {{#times initblattes.blanche}}<span class="blatte blatte-small blatte-blanche"></span>{{/times}}
                {{#times initblattes.noire}}<span class="blatte blatte-small blatte-noire"></span>{{/times}}
            {{else if isOwner}}
                <button type="button" class="combatant-control roll" data-action="rollInitiative" data-tooltip
                        aria-label="{{ localize "COMBAT.InitiativeRoll" }}"></button>
            {{/if}}
        </div>

        {{#if isOwner}}
        {{#if initblattes.nbActions}}
        <div class="token-resource blatte-adjust">
            <div class="blatteup" data-action="blatteup" data-field="1" data-tooltip="Améliorer la couleur d'initiative"
                 data-combatant-id="{{id}}"><i class="fa-solid fa-plus"></i></div>
            <div class="blatteup" data-action="blatteup" data-field="0" data-tooltip="Dégrader la couleur d'initiative"
                 data-combatant-id="{{id}}"><i class="fa-solid fa-minus"></i></div>
        </div>
        {{/if}}
        {{/if}}
    </li>
    {{/each}}
</ol>
