<ol class="combat-tracker plain insectopia-combat-tracker">
  {{#each turns}}
  <li
    class="combatant {{css}}"
    data-combatant-id="{{id}}"
    data-action="activateCombatant"
  >
    <img
      class="token-image"
      src="{{img}}"
      alt="{{name}}"
      loading="lazy"
    />

    <div class="token-name">
      <strong class="name">{{name}}</strong>

      <div class="combatant-controls">
        {{#if @root.user.isGM}}
        <button
          type="button"
          class="inline-control combatant-control icon fa-solid fa-eye-slash {{#if hidden}}active{{/if}}"
          data-action="toggleHidden"
          data-tooltip
          aria-label="{{localize "COMBAT.ToggleVis"}}"
        ></button>

        <button
          type="button"
          class="inline-control combatant-control icon fa-solid fa-skull {{#if isDefeated}}active{{/if}}"
          data-action="toggleDefeated"
          data-tooltip
          aria-label="{{localize "COMBAT.ToggleDead"}}"
        ></button>
        {{/if}}

        {{#if canPing}}
        <button
          type="button"
          class="inline-control combatant-control icon fa-solid fa-bullseye-arrow"
          data-action="pingCombatant"
          data-tooltip
          aria-label="{{localize "COMBAT.PingCombatant"}}"
        ></button>
        {{/if}}

        <div
          class="token-effects"
          data-tooltip-html="{{effects.tooltip}}"
        >
          {{#each effects.icons}}
          <img class="token-effect" src="{{img}}" alt="{{name}}" />
          {{/each}}
        </div>
      </div>
    </div>

    {{#if resource includeZero=true}}
    <div class="token-resource">
      <span class="resource">{{resource}}</span>
    </div>
    {{/if}}

    <div class="token-initiative blattes-initiative">
      {{#if initiative}}
        {{#times initblattes.rouge}}<span class="blatte blatte-small blatte-rouge" title="Initiative rouge"></span>{{/times}}
        {{#times initblattes.verte}}<span class="blatte blatte-small blatte-verte" title="Initiative verte"></span>{{/times}}
        {{#times initblattes.bleue}}<span class="blatte blatte-small blatte-bleue" title="Initiative bleue"></span>{{/times}}
        {{#times initblattes.blanche}}<span class="blatte blatte-small blatte-blanche" title="Initiative blanche"></span>{{/times}}
        {{#times initblattes.noire}}<span class="blatte blatte-small blatte-noire" title="Initiative noire"></span>{{/times}}
      {{else if isOwner}}
      <button
        type="button"
        class="combatant-control roll"
        data-action="rollInitiative"
        data-tooltip
        aria-label="{{localize "COMBAT.InitiativeRoll"}}"
      ></button>
      {{/if}}
    </div>

    {{#if isOwner}}
    {{#if initblattes.nbActions}}
    <div class="token-resource blatte-adjust" aria-label="Ajustement de l’initiative">
      <button
        type="button"
        class="blatteup"
        data-action="blatteup"
        data-field="1"
        data-tooltip="Améliorer la couleur d’initiative"
        data-combatant-id="{{id}}"
        aria-label="Améliorer la couleur d’initiative"
      >
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
      </button>

      <button
        type="button"
        class="blatteup"
        data-action="blatteup"
        data-field="0"
        data-tooltip="Dégrader la couleur d’initiative"
        data-combatant-id="{{id}}"
        aria-label="Dégrader la couleur d’initiative"
      >
        <i class="fa-solid fa-minus" aria-hidden="true"></i>
      </button>
    </div>
    {{/if}}
    {{/if}}
  </li>
  {{/each}}
</ol>
